---
import { getCollection } from "astro:content"
import {  SEO } from "astro-seo"
import BaseLayout from "../../layouts/BaseLayout.astro"

const notes = (await getCollection("notes")).sort()
---

<SEO
  title="Pritesh Tupe | All Notes (Dev-Log)"
  description="A list of all notes related to day-to-day programming stuff"
  canonical="https://www.priteshtupe.com/notes"
/>

<link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
<script src="/pagefind/pagefind-ui.js" is:inline></script>
<script is:inline>
  window.addEventListener("DOMContentLoaded", () => {
    const search = new PagefindUI({
      element: "#noteSearch",
      showSubResults: true,
      showImages: false,
    })
    search.triggerFilters({ collection: ["notes"] })
  })
</script>

<BaseLayout>
  <h1 style="text-align: center;">All Notes</h1>

  <div id="noteSearch"></div>

  <ul class="cloud">
    {
      notes.length &&
        notes.map((note) => <a href={`/notes/${note.id}`}>{note.id}</a>)
    }
  </ul>

  <div style="color:var(--subcontent-color); text-align: center">
    All notes are available at <a
      href="https://github.com/p-tupe/dev-log"
      target="_blank">github.com/p-tupe/dev-log</a
    >
  </div>
</BaseLayout>

<style>
  fieldset.search {
    border: none;
    width: 100%;
    display: flex;
    gap: 1em;

    input {
      border: none;
      border-radius: 0.5em;
      height: 3em;
      flex: 1;
    }

    button[type="submit"] {
      color: var(--emphasis-color);
    }
    button[type="reset"] {
      color: var(--content-color);
    }
  }

  ul.cloud {
    padding-left: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;

    a {
      display: block;
      cursor: pointer;
      padding: 0.5em;
      margin: 0.5em;
      border-radius: 0.5em;
      border: 1px solid var(--subcontent-color);
      color: var(--content-color);
      text-decoration: none;
    }

    a:hover {
      border: 1px solid var(--link-color);
      color: var(--link-color);
    }
  }
</style>
