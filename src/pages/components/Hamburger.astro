---
import ExtLinkIcon from "../../icons/external-link.svg"
import CrossIcon from "../../icons/cross.svg"
import projects from "../../collections/projects"
---

<div class="hamburger">
  <button onclick="openSideMenu()">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="24"
      height="24"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <rect y="4" width="24" height="2" rx="1"></rect>
      <rect y="11" width="24" height="2" rx="1"></rect>
      <rect y="18" width="24" height="2" rx="1"></rect>
    </svg>
  </button>
</div>

<nav class="nav-links hidden">
  <div class="mask">
    <div class="side-menu">
      <button class="closeBtn" onclick="closeSideMenu()">
        <CrossIcon />
      </button>

      <h3>Main Links</h3>
      <ul>
        <li><a href="/">Home</a></li>
        <li><a href="/posts">Posts</a></li>
        <li><a href="/notes">Notes</a></li>
        <li>
          <a
            href="https://cloud.priteshtupe.com/share/fwX95Ul_9x8eYtH0-GzfzoCJl2MCLNHmAU6Pg1hRNnUfXwuyrb2tqxcUwtqzbDnDFrU"
            >Photos <ExtLinkIcon style="fill:var(--link-color)" /></a
          >
        </li>
        <li><a href="/about">About</a></li>
        <li><a href="/rss.xml">Rss</a></li>
        <li><a href="/sitemap-index.xml">Sitemap</a></li>
      </ul>

      <h3>Web Novels</h3>
      <ul>
        <li><a href="/foa">Fate of Arda</a></li>
        <li><a href="/gs">Grand Simulation</a></li>
      </ul>

      <h3>Projects</h3>
      <ul>
        {
          projects.map((p) => (
            <li>
              <a href={p.link} target="_blank">
                {p.title} <ExtLinkIcon style="fill:var(--link-color)" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</nav>

<style>
  .hamburger {
    cursor: pointer;
    position: absolute;
    top: 1em;
    right: 1em;
  }

  nav.nav-links {
    background-color: var(--background-color);
    position: absolute;
    z-index: 9;
    top: 0;
    left: 0;
    width: 100%;
    font-size: 1rem;
    overflow: hidden;

    .mask {
      position: fixed;
      height: 100%;
      width: 100%;
      background-color: rgba(0, 0, 0, 0.85);

      .side-menu {
        position: relative;
        padding: 2em;
        height: 100%;
        background-color: var(--background-color);
        z-index: 99;
        display: flex;
        flex-direction: column;
        justify-content: space-evenly;
        overflow-y: auto;

        .closeBtn {
          position: absolute;
          top: 1em;
          right: 1em;
        }
      }
    }
  }

  .hidden {
    display: none;
  }

  ul {
    margin-top: 0;

    li {
      list-style: "∙ ";
      color: var(--link-color);
      margin-top: 0.5em;
    }
  }

  h3 {
    margin-bottom: 0;
  }

  @media screen and (min-width: 768px) {
    .side-menu {
      margin-left: 75%;
      border-radius: 1em 0 0 1em;
    }
  }
</style>

<script is:inline>
  const nav = document.querySelector("nav.nav-links")
  const openSideMenu = () => {
    nav?.classList.remove("hidden")
    document.body.style.overflow = "hidden"
  }
  const closeSideMenu = () => {
    nav?.classList.add("hidden")
    document.body.style.overflow = "auto"
  }
</script>
