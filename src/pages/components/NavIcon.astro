---
import ExtLinkIcon from "../../icons/external-link.svg"
import CrossIcon from "../../icons/cross.svg"
import { LANG_CODES } from "../../utils/translationData"
const isHome = Astro.url.pathname === "/"
---

<div>
  <button disabled={isHome} aria-label="Home" onclick="window.location.href = '/'">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      width="24"
      height="24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="home"
    >
      <path d="M3 9l9-6 9 6v12a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V9z"></path>
      <polyline points="9 22 9 12 15 12 15 22"></polyline>
    </svg>
  </button>

  <button id="themeToggle" aria-label="Theme Toggle">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      height="24"
      width="24"
      viewBox="0 0 24 24"
    >
      <path
        class="sun"
        fill-rule="evenodd"
        d="M12 17.5a5.5 5.5 0 1 0 0-11 5.5 5.5 0 0 0 0 11zm0 1.5a7 7 0 1 0 0-14 7 7 0 0 0 0 14zm12-7a.8.8 0 0 1-.8.8h-2.4a.8.8 0 0 1 0-1.6h2.4a.8.8 0 0 1 .8.8zM4 12a.8.8 0 0 1-.8.8H.8a.8.8 0 0 1 0-1.6h2.5a.8.8 0 0 1 .8.8zm16.5-8.5a.8.8 0 0 1 0 1l-1.8 1.8a.8.8 0 0 1-1-1l1.7-1.8a.8.8 0 0 1 1 0zM6.3 17.7a.8.8 0 0 1 0 1l-1.7 1.8a.8.8 0 1 1-1-1l1.7-1.8a.8.8 0 0 1 1 0zM12 0a.8.8 0 0 1 .8.8v2.5a.8.8 0 0 1-1.6 0V.8A.8.8 0 0 1 12 0zm0 20a.8.8 0 0 1 .8.8v2.4a.8.8 0 0 1-1.6 0v-2.4a.8.8 0 0 1 .8-.8zM3.5 3.5a.8.8 0 0 1 1 0l1.8 1.8a.8.8 0 1 1-1 1L3.5 4.6a.8.8 0 0 1 0-1zm14.2 14.2a.8.8 0 0 1 1 0l1.8 1.7a.8.8 0 0 1-1 1l-1.8-1.7a.8.8 0 0 1 0-1z"
      ></path>
      <path
        class="moon"
        fill-rule="evenodd"
        d="M16.5 6A10.5 10.5 0 0 1 4.7 16.4 8.5 8.5 0 1 0 16.4 4.7l.1 1.3zm-1.7-2a9 9 0 0 1 .2 2 9 9 0 0 1-11 8.8 9.4 9.4 0 0 1-.8-.3c-.4 0-.8.3-.7.7a10 10 0 0 0 .3.8 10 10 0 0 0 9.2 6 10 10 0 0 0 4-19.2 9.7 9.7 0 0 0-.9-.3c-.3-.1-.7.3-.6.7a9 9 0 0 1 .3.8z"
      ></path>
    </svg>
  </button>

  <div style="display: inline">
    <button id="translateBtn" aria-label="Translate" onclick="toggleLangDropdown()">
      <svg fill="currentColor" width="24" height="24" viewBox="0 0 24 24"
        ><path
          d="M12.87 15.07l-2.54-2.51.03-.03A17.52 17.52 0 0 0 14.07 6H17V4h-7V2H8v2H1v1.99h11.17C11.5 7.92 10.44 9.75 9 11.35 8.07 10.32 7.3 9.19 6.69 8h-2c.73 1.63 1.73 3.17 2.98 4.56l-5.09 5.02L4 19l5-5 3.11 3.11.76-2.04zM18.5 10h-2L12 22h2l1.12-3h4.75L21 22h2l-4.5-12zm-2.62 7l1.62-4.33L19.12 17h-3.24z"
        ></path></svg
      >
    </button>
    <div id="langOptions" onchange="openTranslation(this.value)">
      <span>
        Uses google translate <ExtLinkIcon style="fill:var(--content-color)" />
      </span>
      <button class="closeBtn" onclick="toggleLangDropdown()"
        ><CrossIcon />
      </button>

      {
        Object.keys(LANG_CODES).map((code) => {
          const { language, flag } =
            LANG_CODES[code as unknown as keyof typeof LANG_CODES]
          return (
            <option
              value={code}
              style="cursor: pointer;"
              onclick="openTranslation(this.value)"
            >
              <span set:html={flag} />
              {language}
            </option>
          )
        })
      }
    </div>
  </div>
</div>

<style>
  button {
    border: 0;
    background: none;
    cursor: pointer;
  }
  .sun {
    fill: var(--link-color);
    transition: all 1s;
  }
  .moon {
    fill: transparent;
    transition: all 1s;
  }

  div#langOptions {
    display: none;
    flex-direction: column;
    gap: 1em;
    padding: 1em 1.5em 1em 1em;
    justify-content: space-evenly;
    background-color: var(--background-color);
    box-shadow: 0 1px 4px 1px var(--subcontent-color);
    border-radius: 1em;
    filter: brightness(1.2);
    max-height: 400px;
    min-width: 250px;
    overflow-y: auto;

    span {
      font-weight: 100;
      font-size: 12px;
      color: var(--content-color);
    }

    option:hover {
      color: var(--subcontent-color);
    }

    .closeBtn {
      position: absolute;
      top: 1em;
      right: 1em;
    }
  }

  :global(.dark) .sun {
    fill: transparent;
  }
  :global(.dark) .moon {
    fill: var(--link-color);
  }
</style>

<script is:inline>
  const langOptions = document.getElementById("langOptions")

  function toggleLangDropdown() {
    if (langOptions.style.display == "flex") langOptions.style.display = "none"
    else langOptions.style.display = "flex"
  }

  function openTranslation(value) {
    let path = location.pathname
    if (path == "/") path = ""

    window.open(
      "https://priteshtupe-com.translate.goog/" +
        location.pathname +
        "/?_x_tr_sl=en&_x_tr_tl=" +
        value +
        "&_x_tr_hl=en-US&_x_tr_pto=wapp",
    )

    toggleLangDropdown()
  }
</script>
