---
import { getCollection } from "astro:content"
import { AstroSeo } from "@astrolib/seo"
import ListItem from "../components/ListItem.astro"
import BaseLayout from "../../layouts/BaseLayout.astro"

const allPosts = (await getCollection("posts")).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
)
---

<AstroSeo
  title="Pritesh Tupe | All Posts"
  description="A list of all blog posts written by Pritesh Tupe"
  canonical="https://www.priteshtupe.com/posts"
/>

<link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
<script src="/pagefind/pagefind-ui.js" is:inline></script>

<BaseLayout>
  <script is:inline>
    window.addEventListener("DOMContentLoaded", () => {
      const search = new PagefindUI({
        element: "#postSearch",
        showSubResults: true,
        showImages: false,
      })
      search.triggerFilters({ collection: ["posts"] })
    })
  </script>
  <h1 style="text-align: center;">All Posts</h1>
  <div id="postSearch"></div>
  <section class="list">
    <ul class="list">
      {
        allPosts.map((post) => (
          <ListItem
            subtitle={new Date(post.data.date).toLocaleDateString("en-US", {
              year: "numeric",
              month: "long",
            })}
            title={post.data.title}
            url={`/posts/${post.id}`}
          />
        ))
      }
    </ul>
  </section>
</BaseLayout>
