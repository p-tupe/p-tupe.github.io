---
import { getCollection } from "astro:content"
import { Image } from "astro:assets"

import BaseLayout from "../layouts/BaseLayout.astro"
import ProfilePic2 from "../images/profilePic-2.jpg"
import ListItem from "./components/ListItem.astro"
import ProjectCard from "./components/ProjectCard.astro"
import ExtLinkIcon from "../icons/external-link.svg"
import projects from "../collections/projects"

const pageTitle = "Home Page"

const recentPosts = (await getCollection("posts"))
  .sort(
    (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
  )
  .slice(0, 10)

const latestChapters = (await getCollection("gs"))
  .sort((a, b) => b.data.part - a.data.part)
  .slice(0, 10)
---

<BaseLayout pageTitle={pageTitle}>
  <section class="landing">
    <div style="text-align: center">
      <Image
        width={300}
        height={300}
        fetchpriority="high"
        style="background: black;"
        loading="eager"
        src={ProfilePic2}
        alt="Pritesh Tupe's Profile Pic year 2025"
        class="profilePic"
      />

      <h1>PRITESH TUPE</h1>
      <p style="color: var(--subcontent-color);">
        Programmer | Writer | Violinist
      </p>
    </div>

    <blockquote class="quote">
      With all its sham, drudgery, and broken dreams, it is still a beautiful
      world. Be cheerful. Strive to be happy. &nbsp; <span
        style="color: var(--subcontent-color);text-decoration: none;"
        title="https://desiderata.com/"
      >
        ~ Desiderata
      </span>
    </blockquote>

    <div style="width: 100%; display: flex; justify-content: space-evenly;">
      <a href="/notes">Notes</a>
      <a
        style="align-items: center;"
        href="https://cloud.priteshtupe.com/share/fwX95Ul_9x8eYtH0-GzfzoCJl2MCLNHmAU6Pg1hRNnUfXwuyrb2tqxcUwtqzbDnDFrU"
        target="_blank">Photos <ExtLinkIcon style="fill:var(--link-color)" /></a
      >
      <a href="/about">About</a>
      <a href="/rss.xml" target="_blank">
        RSS <ExtLinkIcon style="fill:var(--link-color)" />
      </a>
    </div>
  </section>

  <section class="list">
    <h1>Recent Posts</h1>
    <ul class="list">
      {
        recentPosts.map((post) => (
          <ListItem
            subtitle={new Date(post.data.date).toLocaleDateString("en-US", {
              year: "numeric",
              month: "long",
            })}
            title={post.data.title}
            url={`/posts/${post.id}`}
          />
        ))
      }
      <ListItem title="Show More" url="/posts" />
    </ul>
  </section>

  <section class="list">
    <h1>Latest Grand Simulation Chapters</h1>
    <ul class="list">
      {
        latestChapters.map((ch) => (
          <ListItem title={ch.data.title} url={`/gs/${ch.id}`} />
        ))
      }
      <ListItem title="Show All" url="/gs" />
    </ul>
  </section>

  <section>
    <h1>Notable Projects</h1>
    <div class="cards">
      {
        projects.map((p) => (
          <ProjectCard
            imageUrl={p.imageUrl}
            title={p.title}
            content={p.content}
            link={p.link}
            isLinkExternal={p.isLinkExternal}
          />
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  section {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-height: 100vh;
    max-height: 100vh;
  }

  section.landing {
    justify-content: space-evenly;

    .profilePic {
      max-width: 300px;
      height: auto;
      margin: 0 auto;
      border-radius: 50%;
      box-shadow: 0 1px 10px 0px var(--content-color);
      opacity: 0.8;
    }
  }

  div.cards {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1em;
  }

  @media screen and (max-width: 768px) {
    div.cards {
      grid-template-columns: repeat(1, 1fr);
    }
  }

  .quote {
    position: relative;
    text-align: center;
    font-family: cursive;
    border: none;
    padding: 0;
    margin: 0;
  }

  @media screen and (min-width: 768px) {
    .quote:before,
    .quote:after {
      position: absolute;
      color: var(--emphasis-color);
      font-size: 4em;
    }

    .quote:before {
      content: "“";
      left: -1rem;
      top: -3.5rem;
    }

    .quote:after {
      content: "”";
      right: -1rem;
      bottom: -4rem;
    }
  }
</style>
