---
import BaseLayout from "./BaseLayout.astro"
import CommentBox from "../pages/components/CommentBox.astro"
import timeAgo from "../utils/timeAgo"
const { data, next, prev } = Astro.props
---

<link rel="stylesheet" href="/codeapi.css" />

<BaseLayout>
  <h1 style="text-align: center; margin-bottom: 0em;">{data.title}</h1>
  <p style="text-align: center; color: var(--subcontent-color);">
    Written {timeAgo(data.date)}
    <button style="font-size:1.05em;color:var(--subcontent-color)" id="shc" data-url="https://app.priteshtupe.com/shc"> &nbsp;&nbsp;&#x2661; </button>
  </p>
  <style>.shc-clicked { color:var(--link-color) !important }</style>
  <slot />
  <hr style="color:var(--subcontent-color);" />
  <aside style="display: flex; width: 100% ; justify-content: space-between; padding: 1em 2em 2em 1em;">
    {"id" in prev && <a href=`/posts/${prev.id}`>◀ {prev.data.title}</a> }
    {"id" in next && <a href=`/posts/${next.id}`>{next.data.title} ▶</a>}
  </aside>
  <CommentBox placeholder="Send feedback..." pageTitle={data.title} />
  <script src="https://app.priteshtupe.com/shc/shc.js" type="text/javascript" ></script>
</BaseLayout>
